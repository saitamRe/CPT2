# PostgreSQL (Docker)
POSTGRES_DB=cpt2
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# App DB connection
DB_DSN=postgresql://user:password@localhost:5433/cpt2

# Binance API
BINANCE_API_BASE=https://data-api.binance.vision
PRICE_URL=/api/v3/ticker/price
REQUEST_TIMEOUT=10

# Portfolio: JSON map of symbol to quantity
PORTFOLIO={"BTC": "0.1", "ETH": "1.0"}

# Pipeline
CLEAN_BATCH_SIZE=2000
LOG_LEVEL=INFO